@prefix ace: <https://acearchive.lgbt/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ace:id a rdf:Property ;
    rdfs:label "ID" ;
    rdfs:comment "A short, stable, unique identifier for an item in the collection." .

ace:slug a rdf:Property ;
    rdfs:label "Slug" ;
    rdfs:comment "A human-readable, descriptive URL slug for an item in the collection." .

ace:alias a rdf:Property ;
    rdfs:label "Slug Alias" ;
    rdfs:comment "An alias for the URL slug that should redirect to the canonical one." .

ace:identity a rdfs:Class ;
    rdfs:label "Identity" ;
    rdfs:comment "An identity label for a person." .

ace:identity a rdf:Property ;
    rdfs:label "Identity" ;
    rdfs:comment "An identity label for a person." .
