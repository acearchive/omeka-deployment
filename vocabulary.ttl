@prefix ace: <https://acearchive.lgbt/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ace:id a rdf:Property ;
    rdfs:label "ID" ;
    rdfs:comment "A short, stable, unique identifier for an item in the collection." ;
    rdfs:subPropertyOf dcterms:identifier .

ace:slug a rdf:Property ;
    rdfs:label "Slug" ;
    rdfs:comment "A human-readable, descriptive URL slug for an item in the collection." ;
    rdfs:subPropertyOf dcterms:identifier .

ace:slugAlias a rdf:Property ;
    rdfs:label "Slug Alias" ;
    rdfs:comment "An alias for the URL slug that should redirect to the canonical one." ;
    rdfs:subPropertyOf dcterms:identifier .

ace:filename a rdf:Property ;
    rdfs:label "Filename" ;
    rdfs:comment "The name of a file associated with an item in the collection. This is unique within the associated item and generally includes a file extension." ;
    rdfs:subPropertyOf dcterms:identifier .

ace:filenameAlias a rdf:Property ;
    rdfs:label "Filename Alias" ;
    rdfs:comment "An alias for the filename that should redirect to the canonical one." ;
    rdfs:subPropertyOf dcterms:identifier .
